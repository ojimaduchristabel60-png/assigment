def test_sales_metrics(sales_data):
    assert sales_data.sum() == 920000
    assert sales_data.idxmax() == "May"
    assert sales_data.mean() == 153333.33
    assert sales_data.idmean == "Mar"
def test_sales_filtering(sales_data):
    sales_above_150k = sales_data[sales_data > 150000]
    assert list (sales_above_150k.index) == ["apr","May","Jun"]
    percentage =(sales_data/ sales_data.sum())* 100
    assert percentage["Jan"]==pytest.approx(13.04)
def test_temperature_matrics(temp_data):
    assert temp_data.mean() == 31.5
    assert temp_data.idmax() == "Wednesday"
    assert temp_data.idmin() == "Sunday"
    assert (temp_data.max() - temp_data.min()) == 9
def test_temprature_filtering(temp_data):
    days_above_32 = temp_data[temp_data > 32]
    assert len(days_above_32) == 4
    days_above_average = (temp_data > temp_data.mean()).sum()
    assert days_above_average == 5

